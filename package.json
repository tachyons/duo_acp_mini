{
  "name": "gitlab-duo-acp",
  "version": "0.1.1",
  "description": "Minimal ACP agent for GitLab Duo chat with OAuth device flow authentication and selectable models",
  "main": "dist/agent.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/agent.js",
    "dev": "tsx src/agent.ts",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "test:pack": "npm pack && tar -tzf *.tgz"
  },
  "keywords": ["gitlab", "duo", "ai", "acp", "agent", "chat", "assistant", "oauth"],
  "author": "Aboobacker MK <aboobackervyd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tachyons/duo_acp_mini.git"
  },
  "bugs": {
    "url": "https://github.com/tachyons/duo_acp_mini/issues"
  },
  "homepage": "https://github.com/tachyons/duo_acp_mini#readme",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "ai": "^7.0.58",
    "gitlab-ai-provider": "^6.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "bin": {
    "gitlab-duo-acp": "dist/agent.js"
  },
  "files": [
    "dist",
    "agent.json",
    "README.md"
  ]
}
